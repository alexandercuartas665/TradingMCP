<UserControl x:Class="HeavyDetailDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0c1018"
             MinWidth="500">
    <UserControl.Resources>
        <Style x:Key="LblMicro" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6c7790"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="ValBig" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e7ecf5"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0c1018">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#121723" BorderBrush="#1f2638" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="txtTitulo" Text="—" Foreground="#e7ecf5"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSub" Text="—" Foreground="#aab3c5"
                               FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="btnCerrar" Content="✕"
                        Width="32" Height="32" Background="Transparent"
                        Foreground="#aab3c5" BorderThickness="0" FontSize="16"
                        Cursor="Hand" Click="btnCerrar_Click"
                        VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Tabs -->
        <Border Grid.Row="1" Background="#0c1018" BorderBrush="#1f2638" BorderThickness="0,0,0,1">
            <StackPanel x:Name="tabsBar" Orientation="Horizontal" Margin="20,0">
                <Button x:Name="tabOverview" Content="Overview" Click="tabClick" Tag="overview"
                        Background="#0c1018" Foreground="#5ee0d0" BorderThickness="0,0,0,2"
                        BorderBrush="#5ee0d0" FontSize="12" FontWeight="SemiBold"
                        Padding="14,10" Cursor="Hand"/>
                <Button x:Name="tabOps" Content="Operaciones" Click="tabClick" Tag="ops"
                        Background="#0c1018" Foreground="#aab3c5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold" Padding="14,10" Cursor="Hand"/>
                <Button x:Name="tabSemanal" Content="Distribución semanal" Click="tabClick" Tag="weekly"
                        Background="#0c1018" Foreground="#aab3c5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold" Padding="14,10" Cursor="Hand"/>
                <Button x:Name="tabRiesgo" Content="Riesgo" Click="tabClick" Tag="risk"
                        Background="#0c1018" Foreground="#aab3c5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold" Padding="14,10" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- TAB OVERVIEW -->
                <StackPanel x:Name="contOverview" Visibility="Visible">
                    <Grid Margin="0,0,0,1" Background="#0c1018">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#1f2638" BorderThickness="0,0,1,1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="TOTAL OPS" Style="{StaticResource LblMicro}"/>
                                <TextBlock x:Name="ovTotalOps" Text="—" Style="{StaticResource ValBig}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#1f2638" BorderThickness="0,0,1,1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="WIN RATE" Style="{StaticResource LblMicro}"/>
                                <TextBlock x:Name="ovWin" Text="—" Style="{StaticResource ValBig}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#1f2638" BorderThickness="0,0,1,1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="PNL NETO" Style="{StaticResource LblMicro}"/>
                                <TextBlock x:Name="ovPnl" Text="—" Style="{StaticResource ValBig}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#1f2638" BorderThickness="0,0,0,1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="DRAWDOWN MAX" Style="{StaticResource LblMicro}"/>
                                <TextBlock x:Name="ovDD" Text="—" Style="{StaticResource ValBig}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border BorderBrush="#1f2638" BorderThickness="0,0,0,1" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="CURVA DE EQUITY · USD ACUMULADO" Style="{StaticResource LblMicro}"
                                       Margin="0,0,0,12"/>
                            <Canvas x:Name="canvasEquity" Background="#07090d" Height="220"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#1f2638" BorderThickness="0,0,0,1" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="DRAWDOWN ROLLING · % SOBRE PEAK" Style="{StaticResource LblMicro}"
                                       Margin="0,0,0,12"/>
                            <Canvas x:Name="canvasDD" Background="#07090d" Height="140"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB OPERACIONES -->
                <StackPanel x:Name="contOps" Visibility="Collapsed">
                    <DataGrid x:Name="dgOps" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#07090d" Foreground="#e7ecf5"
                              RowBackground="#0c1018" AlternatingRowBackground="#10141d"
                              BorderBrush="#1f2638" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1f2638"
                              Margin="0" MaxHeight="600">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Idx}" Width="40"/>
                            <DataGridTextColumn Header="Apertura" Binding="{Binding AperturaStr}" Width="140"/>
                            <DataGridTextColumn Header="Cierre" Binding="{Binding CierreStr}" Width="140"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="60"/>
                            <DataGridTextColumn Header="Entrada" Binding="{Binding EntradaStr}" Width="90"/>
                            <DataGridTextColumn Header="Salida" Binding="{Binding SalidaStr}" Width="90"/>
                            <DataGridTextColumn Header="Resultado" Binding="{Binding Estado}" Width="90"/>
                            <DataGridTextColumn Header="PnL" Binding="{Binding PnlStr}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- TAB SEMANAL -->
                <StackPanel x:Name="contSemanal" Visibility="Collapsed">
                    <Border BorderBrush="#1f2638" BorderThickness="0,0,0,1" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="OPERACIONES POR SEMANA" Style="{StaticResource LblMicro}" Margin="0,0,0,12"/>
                            <Canvas x:Name="canvasSemanal" Background="#07090d" Height="220"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#1f2638" BorderThickness="0,0,0,1" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="WIN RATE SEMANAL · %" Style="{StaticResource LblMicro}" Margin="0,0,0,12"/>
                            <Canvas x:Name="canvasWinSem" Background="#07090d" Height="160"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TAB RIESGO -->
                <StackPanel x:Name="contRiesgo" Visibility="Collapsed">
                    <Grid Background="#0c1018">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#1f2638" BorderThickness="0,0,1,1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="DRAWDOWN MAX" Style="{StaticResource LblMicro}"/>
                                <TextBlock x:Name="rkDD" Text="—" Style="{StaticResource ValBig}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="#1f2638" BorderThickness="0,0,1,1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="SHARPE" Style="{StaticResource LblMicro}"/>
                                <TextBlock x:Name="rkSharpe" Text="—" Style="{StaticResource ValBig}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="#1f2638" BorderThickness="0,0,1,1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="PROFIT FACTOR" Style="{StaticResource LblMicro}"/>
                                <TextBlock x:Name="rkPF" Text="—" Style="{StaticResource ValBig}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" BorderBrush="#1f2638" BorderThickness="0,0,0,1" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="EXP. RETURN" Style="{StaticResource LblMicro}"/>
                                <TextBlock x:Name="rkER" Text="—" Style="{StaticResource ValBig}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border BorderBrush="#1f2638" BorderThickness="0,0,0,1" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="DISTRIBUCION DE PNL · HISTOGRAMA" Style="{StaticResource LblMicro}" Margin="0,0,0,12"/>
                            <Canvas x:Name="canvasHist" Background="#07090d" Height="220"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
