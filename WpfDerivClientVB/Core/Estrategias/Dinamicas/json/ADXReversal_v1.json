{
  "nombre": "ADXReversal_v1",
  "descripcion": "Reversal BB+RSI con filtro ADX. Solo genera senales cuando ADX < 25 (mercado en rango/consolidacion). Cuando ADX >= 25 la tendencia es demasiado fuerte y los rebotes fallan. Disenado para activos mixtos: GBPJPY, DJI, XAUUSD, USDCHF, GBPUSD.",
  "version": "1.0",
  "indicadores": [
    { "id": "bb",  "tipo": "BollingerBands", "params": { "periodo": 20, "desviacion": 2.5 } },
    { "id": "rsi", "tipo": "RSI",            "params": { "periodo": 14 } },
    { "id": "adx", "tipo": "ADX",            "params": { "periodo": 14 } },
    { "id": "atr", "tipo": "ATR",            "params": { "periodo": 14 } }
  ],
  "senal_call": {
    "operador": "AND",
    "condiciones": [
      { "campo": "close", "op": "menor_igual", "valor": "bb.Lower" },
      { "campo": "rsi",   "op": "menor_que",   "valor": 35 },
      { "campo": "adx",   "op": "menor_que",   "valor": 25 }
    ]
  },
  "senal_put": {
    "operador": "AND",
    "condiciones": [
      { "campo": "close", "op": "mayor_igual", "valor": "bb.Upper" },
      { "campo": "rsi",   "op": "mayor_que",   "valor": 65 },
      { "campo": "adx",   "op": "menor_que",   "valor": 25 }
    ]
  },
  "confianza_base": 60,
  "ajustes_confianza": [
    { "si": { "campo": "adx", "op": "menor_que", "valor": 15 }, "sumar": 15 },
    { "si": { "campo": "adx", "op": "menor_que", "valor": 20 }, "sumar": 10 },
    { "si": { "campo": "rsi", "op": "menor_que", "valor": 25 }, "sumar": 10 },
    { "si": { "campo": "rsi", "op": "mayor_que", "valor": 75 }, "sumar": 10 }
  ]
}
