{
  "nombre": "BollingerRsiReversal_d20",
  "descripcion": "Reversal BB desviacion 2.0 - mas senales, rebotes menos extremos. RSI<30/>70.",
  "version": "opt",
  "indicadores": [
    { "id": "bb",  "tipo": "BollingerBands", "params": { "periodo": 20, "desviacion": 2.0 } },
    { "id": "rsi", "tipo": "RSI",            "params": { "periodo": 14 } },
    { "id": "atr", "tipo": "ATR",            "params": { "periodo": 14 } }
  ],
  "senal_call": {
    "operador": "AND",
    "condiciones": [
      { "campo": "close", "op": "menor_igual", "valor": "bb.Lower" },
      { "campo": "rsi",   "op": "menor_que",   "valor": 30 }
    ]
  },
  "senal_put": {
    "operador": "AND",
    "condiciones": [
      { "campo": "close", "op": "mayor_igual", "valor": "bb.Upper" },
      { "campo": "rsi",   "op": "mayor_que",   "valor": 70 }
    ]
  },
  "confianza_base": 65,
  "ajustes_confianza": [
    { "si": { "campo": "rsi", "op": "menor_que", "valor": 20 }, "sumar": 20 },
    { "si": { "campo": "rsi", "op": "mayor_que", "valor": 80 }, "sumar": 20 },
    { "si": { "campo": "rsi", "op": "menor_que", "valor": 25 }, "sumar": 10 },
    { "si": { "campo": "rsi", "op": "mayor_que", "valor": 75 }, "sumar": 10 },
    { "si": { "campo": "bb.BandWidth", "op": "menor_que", "valor": 3 }, "sumar": -15 }
  ]
}
