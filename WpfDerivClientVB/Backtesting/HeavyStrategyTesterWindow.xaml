<Window x:Class="HeavyStrategyTesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Heavy Strategy Tester"
        Width="1600" Height="900"
        Background="#07090d"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Chip multi-select -->
        <Style x:Key="ChipStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#121723"/>
            <Setter Property="Foreground" Value="#aab3c5"/>
            <Setter Property="BorderBrush" Value="#1f2638"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#0d2a30"/>
                    <Setter Property="Foreground" Value="#5ee0d0"/>
                    <Setter Property="BorderBrush" Value="#5ee0d0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#2d3651"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelHdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#aab3c5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="MicroLbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6c7790"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="InputDark" TargetType="TextBox">
            <Setter Property="Background" Value="#121723"/>
            <Setter Property="Foreground" Value="#e7ecf5"/>
            <Setter Property="BorderBrush" Value="#1f2638"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="#0d2a30"/>
            <Setter Property="Foreground" Value="#5ee0d0"/>
            <Setter Property="BorderBrush" Value="#5ee0d0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="#121723"/>
            <Setter Property="Foreground" Value="#aab3c5"/>
            <Setter Property="BorderBrush" Value="#1f2638"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ╔═════ HEADER ═════╗ -->
        <Border Grid.Row="0" Background="#0c1018" BorderBrush="#1f2638" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="🧪" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="HEAVY STRATEGY TESTER" Foreground="#5ee0d0"
                                   FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="Backtesting masivo · sin API server · solo BD" Foreground="#6c7790"
                                   FontSize="10" FontFamily="Consolas"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Border Background="#121723" BorderBrush="#1f2638" BorderThickness="1"
                            CornerRadius="3" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="pillEngine" Text="Engine v0.9 · idle"
                                   Foreground="#aab3c5" FontSize="10" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#121723" BorderBrush="#1f2638" BorderThickness="1"
                            CornerRadius="3" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="Source: Replay BD" Foreground="#aab3c5"
                                   FontSize="10" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#121723" BorderBrush="#1f2638" BorderThickness="1"
                            CornerRadius="3" Padding="10,4">
                        <TextBlock x:Name="pillJobs" Text="Jobs: 0"
                                   Foreground="#aab3c5" FontSize="10" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ╔═════ MAIN ═════╗ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT: CONFIG ─── -->
            <Border Grid.Column="0" Background="#0c1018" BorderBrush="#1f2638" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <!-- Activos -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ACTIVOS" Style="{StaticResource LabelHdr}"/>
                            <TextBlock Grid.Column="1" x:Name="lblAssetsCount" Text="0 sel"
                                       Foreground="#6c7790" FontSize="9" FontFamily="Consolas"/>
                        </Grid>
                        <ItemsControl x:Name="chipsAssets" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Estrategias -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="ESTRATEGIAS" Style="{StaticResource LabelHdr}"/>
                            <TextBlock Grid.Column="1" x:Name="lblStratsCount" Text="0 sel"
                                       Foreground="#6c7790" FontSize="9" FontFamily="Consolas"/>
                        </Grid>
                        <Border Background="#121723" BorderBrush="#1f2638" BorderThickness="1"
                                CornerRadius="3" Margin="0,0,0,16" MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="listStrats" Margin="4"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Timeframes -->
                        <TextBlock Text="TEMPORALIDADES" Style="{StaticResource LabelHdr}"/>
                        <ItemsControl x:Name="chipsTfs" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Confianza -->
                        <TextBlock Text="CONFIANZA % · min/max/step ó 3 valores"
                                   Style="{StaticResource LabelHdr}"
                                   ToolTip="Si el 3er campo (step) es mayor al rango (max-min), las 3 casillas se interpretan como 3 valores discretos. Ej: 65/75/90 → genera 3 confianzas. 55/75/10 → genera 55,65,75."/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtConfMin" Style="{StaticResource InputDark}" Text="55" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" x:Name="txtConfMax" Style="{StaticResource InputDark}" Text="75" Margin="2,0,2,0"/>
                            <TextBox Grid.Column="2" x:Name="txtConfStep" Style="{StaticResource InputDark}" Text="10" Margin="4,0,0,0"/>
                        </Grid>

                        <!-- Payout -->
                        <TextBlock Text="PAYOUT % · min/max/step ó 3 valores"
                                   Style="{StaticResource LabelHdr}"
                                   ToolTip="Mismo comportamiento que Confianza. Ej: 85/90/95 → genera 3 payouts."/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtPayMin" Style="{StaticResource InputDark}" Text="80" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" x:Name="txtPayMax" Style="{StaticResource InputDark}" Text="90" Margin="2,0,2,0"/>
                            <TextBox Grid.Column="2" x:Name="txtPayStep" Style="{StaticResource InputDark}" Text="5" Margin="4,0,0,0"/>
                        </Grid>

                        <!-- Duracion -->
                        <TextBlock Text="DURACION VELAS · min/max/step ó 3 valores"
                                   Style="{StaticResource LabelHdr}"
                                   ToolTip="Igual que Confianza/Payout. Ej: 1/3/5 → genera 1,3,5 velas."/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="txtDurMin" Style="{StaticResource InputDark}" Text="3" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" x:Name="txtDurMax" Style="{StaticResource InputDark}" Text="7" Margin="2,0,2,0"/>
                            <TextBox Grid.Column="2" x:Name="txtDurStep" Style="{StaticResource InputDark}" Text="2" Margin="4,0,0,0"/>
                        </Grid>

                        <!-- Capital -->
                        <TextBlock Text="CAPITAL $ · multiselect" Style="{StaticResource LabelHdr}"/>
                        <ItemsControl x:Name="chipsCap" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Periodo -->
                        <TextBlock Text="PERIODO DE PRUEBA" Style="{StaticResource LabelHdr}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" x:Name="dpDesde" Margin="0,0,4,0" Background="#121723"/>
                            <DatePicker Grid.Column="1" x:Name="dpHasta" Margin="4,0,0,0" Background="#121723"/>
                        </Grid>

                        <!-- Concurrencia -->
                        <TextBlock Text="CONCURRENCIA · 1..8" Style="{StaticResource LabelHdr}"/>
                        <TextBox x:Name="txtConcurrencia" Style="{StaticResource InputDark}" Text="2" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ─── CENTER: RESULTADOS ─── -->
            <Grid Grid.Column="1" Background="#07090d">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- KPI strip -->
                <Border Grid.Row="0" Background="#0c1018" BorderBrush="#1f2638" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="16,12">
                            <TextBlock Text="COMBINACIONES" Style="{StaticResource MicroLbl}"/>
                            <TextBlock x:Name="kCombi" Text="—" Foreground="#e7ecf5" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="kCombiSub" Text="sin ejecutar" Foreground="#6c7790"
                                       FontSize="9" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,12">
                            <TextBlock Text="GANADORAS" Style="{StaticResource MicroLbl}"/>
                            <TextBlock x:Name="kWin" Text="—" Foreground="#3fd17a" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="win&gt;50% &amp; PnL&gt;0" Foreground="#6c7790"
                                       FontSize="9" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="16,12">
                            <TextBlock Text="OPS/SEM PROM" Style="{StaticResource MicroLbl}"/>
                            <TextBlock x:Name="kOpsW" Text="—" Foreground="#e7ecf5" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="por estrategia" Foreground="#6c7790"
                                       FontSize="9" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="16,12">
                            <TextBlock Text="TOTAL OPS" Style="{StaticResource MicroLbl}"/>
                            <TextBlock x:Name="kOpsT" Text="—" Foreground="#e7ecf5" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="acumulado" Foreground="#6c7790"
                                       FontSize="9" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="16,12">
                            <TextBlock Text="PNL NETO" Style="{StaticResource MicroLbl}"/>
                            <TextBlock x:Name="kPnl" Text="—" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="USD agregado" Foreground="#6c7790"
                                       FontSize="9" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5" Margin="16,12">
                            <TextBlock Text="MEJOR COMBINACION" Style="{StaticResource MicroLbl}"/>
                            <TextBlock x:Name="kBest" Text="—" Foreground="#5ee0d0" FontSize="11"
                                       FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="kBestSub" Text="—" Foreground="#6c7790"
                                       FontSize="9" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filter row -->
                <Border Grid.Row="1" Background="#0c1018" BorderBrush="#1f2638" BorderThickness="0,0,0,1" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnFiltroTodos" Content="Todos" Style="{StaticResource BtnPrimary}"
                                Click="btnFiltro_Click" Tag="all" Margin="0,0,4,0"/>
                        <Button x:Name="btnFiltroGanadoras" Content="Ganadoras" Style="{StaticResource BtnGhost}"
                                Click="btnFiltro_Click" Tag="winners" Margin="0,0,4,0"/>
                        <Button x:Name="btnFiltroPerdedoras" Content="Perdedoras" Style="{StaticResource BtnGhost}"
                                Click="btnFiltro_Click" Tag="losers" Margin="0,0,4,0"/>
                        <Button x:Name="btnFiltroTop10" Content="Top 10" Style="{StaticResource BtnGhost}"
                                Click="btnFiltro_Click" Tag="top10" Margin="0,0,16,0"/>
                        <Button x:Name="btnExportarCsv" Content="📥 Exportar CSV" Style="{StaticResource BtnGhost}"
                                Click="btnExportarCsv_Click" Margin="0,0,16,0"/>
                        <Button x:Name="btnSeleccionarTodas" Content="☑ Seleccionar todas" Style="{StaticResource BtnGhost}"
                                Click="btnSeleccionarTodas_Click" Margin="0,0,4,0"
                                ToolTip="Marca todas las filas visibles según el filtro actual"/>
                        <Button x:Name="btnDeseleccionarTodas" Content="☐ Deseleccionar" Style="{StaticResource BtnGhost}"
                                Click="btnDeseleccionarTodas_Click" Margin="0,0,16,0"
                                ToolTip="Quita la selección de todas las filas"/>
                        <Button x:Name="btnVerOperaciones" Content="👁 Ver operaciones" Style="{StaticResource BtnGhost}"
                                Click="btnVerOperaciones_Click" Margin="0,0,4,0"/>
                        <Button x:Name="btnEliminarSeleccion" Content="🗑 Eliminar seleccionados"
                                Background="#3a2230" Foreground="#ffffff" BorderBrush="#ff5c7a"
                                BorderThickness="1" Padding="10,6" FontWeight="SemiBold" FontSize="11"
                                Cursor="Hand" Click="btnEliminarSeleccion_Click" Margin="0,0,4,0"/>
                        <TextBlock x:Name="lblSeleccionados" Text="0 sel" Foreground="#aab3c5"
                                   FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ╔═════ ACORDEON FILTROS AVANZADOS ═════╗ -->
                <Expander Grid.Row="2" x:Name="expFiltros" Background="#10141d" Foreground="#e7ecf5"
                          BorderBrush="#1f2638" BorderThickness="0,0,0,1" IsExpanded="False"
                          Expanded="expFiltros_Toggled" Collapsed="expFiltros_Toggled">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="6,0,8,0"/>
                            <TextBlock Text="FILTROS AVANZADOS" Foreground="#5ee0d0"
                                       FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblFiltroResumen" Text=""
                                       Foreground="#aab3c5" FontSize="10" FontFamily="Consolas"
                                       Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <Border Background="#0c1018" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Fila 1: text/combo -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="ESTRATEGIA (contiene)" Style="{StaticResource MicroLbl}"/>
                                    <TextBox x:Name="txtFltEstrategia" Style="{StaticResource InputDark}"
                                             Margin="0,3,0,0" TextChanged="filtroChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,8">
                                    <TextBlock Text="ACTIVO" Style="{StaticResource MicroLbl}"/>
                                    <ComboBox x:Name="cmbFltActivo" Margin="0,3,0,0"
                                              Background="#121723" Foreground="#e7ecf5"
                                              BorderBrush="#1f2638" Height="26"
                                              SelectionChanged="filtroSelChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,0,4,8">
                                    <TextBlock Text="TIMEFRAME" Style="{StaticResource MicroLbl}"/>
                                    <ComboBox x:Name="cmbFltTf" Margin="0,3,0,0"
                                              Background="#121723" Foreground="#e7ecf5"
                                              BorderBrush="#1f2638" Height="26"
                                              SelectionChanged="filtroSelChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="3" Margin="8,0,0,8">
                                    <TextBlock Text="ESTADO" Style="{StaticResource MicroLbl}"/>
                                    <ComboBox x:Name="cmbFltEstado" Margin="0,3,0,0"
                                              Background="#121723" Foreground="#e7ecf5"
                                              BorderBrush="#1f2638" Height="26"
                                              SelectionChanged="filtroSelChanged"/>
                                </StackPanel>

                                <!-- Fila 2: rangos riesgo -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="CONFIANZA % · min-max" Style="{StaticResource MicroLbl}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtFltConfMin" Style="{StaticResource InputDark}"
                                                 Margin="0,0,3,0" TextChanged="filtroChanged"/>
                                        <TextBox Grid.Column="1" x:Name="txtFltConfMax" Style="{StaticResource InputDark}"
                                                 Margin="3,0,0,0" TextChanged="filtroChanged"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,8">
                                    <TextBlock Text="PAYOUT % · min-max" Style="{StaticResource MicroLbl}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtFltPayMin" Style="{StaticResource InputDark}"
                                                 Margin="0,0,3,0" TextChanged="filtroChanged"/>
                                        <TextBox Grid.Column="1" x:Name="txtFltPayMax" Style="{StaticResource InputDark}"
                                                 Margin="3,0,0,0" TextChanged="filtroChanged"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,0,4,8">
                                    <TextBlock Text="DURACION VELAS · min-max" Style="{StaticResource MicroLbl}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtFltDurMin" Style="{StaticResource InputDark}"
                                                 Margin="0,0,3,0" TextChanged="filtroChanged"/>
                                        <TextBox Grid.Column="1" x:Name="txtFltDurMax" Style="{StaticResource InputDark}"
                                                 Margin="3,0,0,0" TextChanged="filtroChanged"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="3" Margin="8,0,0,8">
                                    <TextBlock Text="CAPITAL $ · min-max" Style="{StaticResource MicroLbl}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtFltCapMin" Style="{StaticResource InputDark}"
                                                 Margin="0,0,3,0" TextChanged="filtroChanged"/>
                                        <TextBox Grid.Column="1" x:Name="txtFltCapMax" Style="{StaticResource InputDark}"
                                                 Margin="3,0,0,0" TextChanged="filtroChanged"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Fila 3: rangos resultados -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                                    <TextBlock Text="WIN % · min-max" Style="{StaticResource MicroLbl}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtFltWinMin" Style="{StaticResource InputDark}"
                                                 Margin="0,0,3,0" TextChanged="filtroChanged"/>
                                        <TextBox Grid.Column="1" x:Name="txtFltWinMax" Style="{StaticResource InputDark}"
                                                 Margin="3,0,0,0" TextChanged="filtroChanged"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,4,8">
                                    <TextBlock Text="PNL · min-max" Style="{StaticResource MicroLbl}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtFltPnlMin" Style="{StaticResource InputDark}"
                                                 Margin="0,0,3,0" TextChanged="filtroChanged"/>
                                        <TextBox Grid.Column="1" x:Name="txtFltPnlMax" Style="{StaticResource InputDark}"
                                                 Margin="3,0,0,0" TextChanged="filtroChanged"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="4,0,4,8">
                                    <TextBlock Text="OPERACIONES · min-max" Style="{StaticResource MicroLbl}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtFltOpsMin" Style="{StaticResource InputDark}"
                                                 Margin="0,0,3,0" TextChanged="filtroChanged"/>
                                        <TextBox Grid.Column="1" x:Name="txtFltOpsMax" Style="{StaticResource InputDark}"
                                                 Margin="3,0,0,0" TextChanged="filtroChanged"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="3" Margin="8,0,0,8">
                                    <TextBlock Text="SHARPE min · DD% max" Style="{StaticResource MicroLbl}"/>
                                    <Grid Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="txtFltSharpeMin" Style="{StaticResource InputDark}"
                                                 Margin="0,0,3,0" TextChanged="filtroChanged"/>
                                        <TextBox Grid.Column="1" x:Name="txtFltDDMax" Style="{StaticResource InputDark}"
                                                 Margin="3,0,0,0" TextChanged="filtroChanged"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Fila 4: checkboxes + acciones -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox x:Name="chkFltSoloGanadoras" Content="Solo ganadoras (Win≥50% y PnL>0)"
                                              Foreground="#e7ecf5" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"
                                              Checked="filtroChkChanged" Unchecked="filtroChkChanged"/>
                                    <CheckBox x:Name="chkFltSoloPersistidas" Content="Solo guardadas en BD"
                                              Foreground="#e7ecf5" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0"
                                              Checked="filtroChkChanged" Unchecked="filtroChkChanged"/>
                                    <CheckBox x:Name="chkFltConOps" Content="Con operaciones (Ops>0)"
                                              Foreground="#e7ecf5" FontSize="11" VerticalAlignment="Center"
                                              Checked="filtroChkChanged" Unchecked="filtroChkChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                    <Button x:Name="btnLimpiarFiltros" Content="Limpiar filtros"
                                            Style="{StaticResource BtnGhost}" Click="btnLimpiarFiltros_Click"
                                            Margin="0,0,4,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- DataGrid resultados -->
                <DataGrid Grid.Row="3" x:Name="dgResultados" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True" Background="#07090d" Foreground="#e7ecf5"
                          RowBackground="#0c1018" AlternatingRowBackground="#10141d"
                          BorderBrush="#1f2638" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1f2638" SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#2a3142"/>
                            <Setter Property="Foreground" Value="#ffffff"/>
                            <Setter Property="BorderBrush" Value="#3a4258"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="36" CanUserSort="False">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox x:Name="chkAllRows" ToolTip="Marcar/desmarcar todos"
                                              Checked="chkAllRows_Toggled" Unchecked="chkAllRows_Toggled"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Checked="rowChk_Toggled" Unchecked="rowChk_Toggled"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Ver" Width="70" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="👁 Ver" Click="btnVerOpsRow_Click"
                                            Background="#0d2a30" Foreground="#5ee0d0"
                                            BorderBrush="#5ee0d0" BorderThickness="1"
                                            Padding="6,2" FontSize="10" FontWeight="SemiBold"
                                            Cursor="Hand" Margin="3"
                                            ToolTip="Abrir ventana con todas las operaciones de esta sesión"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#" Binding="{Binding RankStr}" Width="50"/>
                        <DataGridTextColumn Header="Estrategia" Binding="{Binding Estrategia}" Width="*"/>
                        <DataGridTextColumn Header="Activo" Binding="{Binding Activo}" Width="80"/>
                        <DataGridTextColumn Header="TF" Binding="{Binding Timeframe}" Width="50"/>
                        <DataGridTextColumn Header="Conf" Binding="{Binding ConfStr}" Width="60"/>
                        <DataGridTextColumn Header="Pay" Binding="{Binding PayStr}" Width="60"/>
                        <DataGridTextColumn Header="Dur" Binding="{Binding Dur}" Width="50"/>
                        <DataGridTextColumn Header="Cap" Binding="{Binding CapStr}" Width="80"/>
                        <DataGridTextColumn Header="Ops" Binding="{Binding Ops}" Width="60"/>
                        <DataGridTextColumn Header="Ops/Sem" Binding="{Binding OpsSemStr}" Width="70"/>
                        <DataGridTemplateColumn Header="Win%" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding WinStr}" Foreground="{Binding WinBrush}"
                                               FontWeight="SemiBold" Margin="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="PnL" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PnlStr}" Foreground="{Binding PnlBrush}"
                                               FontWeight="Bold" Margin="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DD%" Binding="{Binding DDStr}" Width="60"/>
                        <DataGridTextColumn Header="Sharpe" Binding="{Binding SharpeStr}" Width="65"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80"/>
                        <DataGridTextColumn Header="Inicio" Binding="{Binding InicioStr}" Width="75"/>
                        <DataGridTextColumn Header="Fin" Binding="{Binding FinStr}" Width="75"/>
                        <DataGridTextColumn Header="Duración" Binding="{Binding DuracionStr}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ─── RIGHT: COLA ─── -->
            <Border Grid.Column="2" Background="#0c1018" BorderBrush="#1f2638" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header cola -->
                    <StackPanel Grid.Row="0" Margin="14">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COLA DE EJECUCION" Style="{StaticResource LabelHdr}" Margin="0"/>
                            <Border Grid.Column="1" Background="#121723" BorderBrush="#1f2638" BorderThickness="1"
                                    CornerRadius="8" Padding="6,1">
                                <TextBlock x:Name="lblQueueCount" Text="0 jobs"
                                           Foreground="#aab3c5" FontSize="9" FontFamily="Consolas"/>
                            </Border>
                        </Grid>
                        <Button x:Name="btnGenerar" Content="＋ Generar combinaciones" Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Stretch" Click="btnGenerar_Click" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="btnLimpiar" Content="Limpiar" Style="{StaticResource BtnGhost}"
                                    HorizontalAlignment="Stretch" Click="btnLimpiar_Click" Margin="0,0,2,0"/>
                            <Button Grid.Column="1" x:Name="btnEjecutar" Content="▶ Ejecutar" Style="{StaticResource BtnPrimary}"
                                    HorizontalAlignment="Stretch" Click="btnEjecutar_Click" Margin="2,0,0,0"/>
                        </Grid>
                        <Button x:Name="btnDetener" Content="■ Detener ejecución"
                                HorizontalAlignment="Stretch" Click="btnDetener_Click" IsEnabled="False"
                                Background="#3a2230" Foreground="#ffffff" BorderBrush="#ff5c7a"
                                BorderThickness="1" Padding="10,7" FontWeight="SemiBold" FontSize="11"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#3a2230"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                    <Setter Property="BorderBrush" Value="#ff5c7a"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#1a1f2a"/>
                                            <Setter Property="Foreground" Value="#5a6378"/>
                                            <Setter Property="BorderBrush" Value="#2a3142"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#5a2a3a"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!-- Lista jobs -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,14,8">
                        <ItemsControl x:Name="lstJobs">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#121723" BorderBrush="#1f2638" BorderThickness="1"
                                            CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Id}"
                                                           Foreground="#475066" FontFamily="Consolas" FontSize="10"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding EstadoStr}"
                                                           Foreground="{Binding EstadoBrush}"
                                                           FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                                                <Button Grid.Column="3" Content="✕" Width="18" Height="16"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#6c7790" FontSize="10" Margin="6,0,0,0"
                                                        Cursor="Hand" Padding="0" ToolTip="Eliminar job"
                                                        Click="btnEliminarJob_Click"/>
                                            </Grid>
                                            <TextBlock Text="{Binding NombreCorto}" Foreground="#e7ecf5"
                                                       FontFamily="Consolas" FontSize="11" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding MetaStr}" Foreground="#6c7790"
                                                       FontFamily="Consolas" FontSize="9"/>
                                            <!-- Tiempos inicio → fin -->
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding TiemposStr}"
                                                           Foreground="#8a93a8" FontFamily="Consolas" FontSize="9"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DuracionStr}"
                                                           Foreground="#ffb454" FontFamily="Consolas" FontSize="9"
                                                           FontWeight="Bold"/>
                                            </Grid>
                                            <!-- Velas en vivo + ganadas/perdidas en vivo -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📊" FontSize="9"
                                                           VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding VelasStr}"
                                                           Foreground="#5cb6ff" FontFamily="Consolas" FontSize="9"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ResultadoEnVivoStr}"
                                                           Foreground="#3fd17a" FontFamily="Consolas" FontSize="9"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding Progreso, Mode=OneWay}" Maximum="100"
                                                         Height="3" Margin="0,6,0,0"
                                                         Background="#0c1018" Foreground="#5ee0d0"
                                                         BorderThickness="0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Capacidad estimada -->
                    <Border Grid.Row="2" Background="#10141d" BorderBrush="#1f2638" BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="CAPACIDAD ESTIMADA" Style="{StaticResource MicroLbl}"/>
                            <TextBlock x:Name="lblEstTotal" Text="0" Foreground="#5ee0d0"
                                       FontSize="22" FontWeight="Bold" Margin="0,4,0,2"/>
                            <TextBlock Text="combinaciones potenciales" Foreground="#6c7790"
                                       FontSize="10" FontFamily="Consolas" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Activos" Foreground="#aab3c5" FontSize="10"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblEstAssets" Text="0" Foreground="#e7ecf5" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Estrategias" Foreground="#aab3c5" FontSize="10"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblEstStrats" Text="0" Foreground="#e7ecf5" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Temporalidades" Foreground="#aab3c5" FontSize="10"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="lblEstTfs" Text="0" Foreground="#e7ecf5" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Niveles riesgo" Foreground="#aab3c5" FontSize="10"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblEstRisk" Text="0" Foreground="#e7ecf5" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Montos capital" Foreground="#aab3c5" FontSize="10"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="lblEstCap" Text="0" Foreground="#e7ecf5" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Tiempo estimado" Foreground="#aab3c5" FontSize="10"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="lblEstTime" Text="— min" Foreground="#ffb454" FontSize="10" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ╔═════ STATUS BAR ═════╗ -->
        <Border Grid.Row="2" Background="#0c1018" BorderBrush="#1f2638" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="● Conectado · Replay BD" Foreground="#3fd17a"
                               FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtStatus" Text="Listo" Foreground="#aab3c5"
                               FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="v0.9.2-beta" Foreground="#6c7790"
                               FontSize="10" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtClock" Text="" Foreground="#6c7790"
                               FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ╔═════ DRAWER OVERLAY ═════╗ -->
        <Grid x:Name="overlayDrawer" Grid.RowSpan="3" Background="#88000000" Visibility="Collapsed"
              MouseLeftButtonDown="overlayDrawer_BgClick">
            <Grid Width="900" HorizontalAlignment="Right" Background="#0c1018"
                  MouseLeftButtonDown="OverlayDrawerStop_Click">
                <ContentControl x:Name="drawerContent"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
